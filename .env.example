APP_NAME=TrailDive
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sentry error tracking. Leave the DSN empty to disable (nothing is sent).
# In production set a low traces sample rate to control cost.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# Nightly database backup (spatie/laravel-backup). Stored on the private R2
# bucket by default; failures/successes are emailed to BACKUP_NOTIFICATION_EMAIL.
BACKUP_DISK=r2_private
BACKUP_NOTIFICATION_EMAIL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=traildive
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Hold marketing broadcasts (new trip / new round) created 21:00–08:00 until
# morning. Set false to push immediately, any hour.
BROADCAST_QUIET_HOURS=true

# Cloudflare R2 — used for public media (photos, reviews, chat, avatars, …).
# Endpoint: https://<account_id>.r2.cloudflarestorage.com
# Public URL: your custom domain bound to the bucket, e.g. https://media.luilaykhao.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=luilaykhao
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_REGION=auto

# Separate PRIVATE bucket for sensitive files (payment slips). Must NOT have a
# public custom domain / r2.dev URL — slips are served via signed URLs only.
R2_PRIVATE_BUCKET=luilaykhao-private

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=traildive
REVERB_APP_KEY=traildive-key
REVERB_APP_SECRET=traildive-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

OMISE_PUBLIC_KEY=pkey_test_xxx
OMISE_SECRET_KEY=skey_test_xxx
OMISE_WEBHOOK_SECRET=

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-smtp-login@email.com
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@traildive.com"
MAIL_FROM_NAME="${APP_NAME}"

LINE_CHANNEL_TOKEN=
SMS_PROVIDER=
THAIBULKSMS_ENABLED=false
THAIBULKSMS_API_KEY=
THAIBULKSMS_API_SECRET=
THAIBULKSMS_SENDER=LUILAYKHAO
THAIBULKSMS_CREDIT_TYPE=standard
THAIBULKSMS_ENDPOINT=https://api-v2.thaibulksms.com/sms
THAIBULKSMS_CREDIT_ENDPOINT=https://api-v2.thaibulksms.com/credit
THAIBULKSMS_SHORTEN_URL=
THAIBULKSMS_EXPIRE=
THAIBULKSMS_TIMEOUT=10

# Payment provider: manual = PromptPay QR ที่เราสร้างเอง + ลูกค้าอัปสลิป + OCR
#                   beam   = Beam Checkout ออก QR และยืนยันเงินเข้าให้ผ่าน webhook
PAYMENT_PROVIDER=manual

# Beam Checkout (https://docs.beamcheckout.com) — merchant id + api key จาก Lighthouse
# ปล่อย BEAM_MERCHANT_ID หรือ BEAM_API_KEY ว่าง = ปิดฟีเจอร์ แม้ PAYMENT_PROVIDER=beam
# BEAM_WEBHOOK_SECRET คือ HMAC key จาก Lighthouse (เป็น base64 มาแล้ว วางตรงๆ ได้เลย)
# prod ใช้ https://api.beamcheckout.com
BEAM_BASE_URL=https://playground.api.beamcheckout.com
BEAM_MERCHANT_ID=
BEAM_API_KEY=
BEAM_WEBHOOK_SECRET=
BEAM_QR_TTL_MINUTES=15
# ปลายทางหลังจ่ายผ่านแอปธนาคาร — เว้นว่างได้ จะใช้ APP_URL + /payment/return ให้เอง
BEAM_RETURN_URL=

# PromptPay / bank transfer (public payment page + QR). Defaults match the Flutter app.
PROMPTPAY_ID=004999239362071
PROMPTPAY_ID_DISPLAY=004-99923936-2071
PAYMENT_MERCHANT_NAME=LUILAYKHAO
PAYMENT_BANK_NAME="ธนาคารกสิกรไทย"
PAYMENT_BANK_ACCOUNT=230-139095-8
PAYMENT_BANK_HOLDER="บจก. ลุยล้ายเขา"
PAYMENT_SUPPORT_PHONE=062-612-6006
# Shared secret for authenticating inbound payment-gateway webhooks (HMAC-SHA256
# of the raw body, hex, in the X-Payment-Signature header). Leave empty to
# disable the webhook endpoint.
PAYMENT_WEBHOOK_SECRET=

# Google Maps (server-side): เส้นทางเดินรถตามถนนจริง + ETA จุดรับ
# ต้องเปิด API: Directions API และ Distance Matrix API แล้ว restrict คีย์ด้วย
# IP ของเซิร์ฟเวอร์ ปล่อยว่างไว้ = แอปลากเส้นตรงระหว่างจุดแทน (ไม่พัง)
# คีย์ของแอปมือถือ (Maps SDK) เป็นคนละคีย์ อยู่ในฝั่งแอป ไม่ใช่ที่นี่
GOOGLE_MAPS_API_KEY=

# Weather forecast (trip weather card + pre-departure weather alerts).
# OPENWEATHER_API_KEY = API key from https://openweathermap.org/api (free tier
# covers the 5-day/3-hour forecast). Leave blank to disable weather features.
WEATHER_PROVIDER=openweather
OPENWEATHER_API_KEY=
# OPENWEATHER_BASE_URL=https://api.openweathermap.org
# WEATHER_CACHE_TTL_MINUTES=180

# Anthropic Claude API (OCR สลิป + AI ผู้ช่วยวางทริป)
ANTHROPIC_API_KEY=
# รุ่นที่ผู้ช่วยวางทริปใช้ ยกระดับเป็น claude-sonnet-5 ได้ถ้าคำแนะนำยังไม่ตรงพอ
ANTHROPIC_CONCIERGE_MODEL=claude-haiku-4-5

# Firebase Cloud Messaging (push notifications).
# FCM_PROJECT_ID = the "Project ID" from Firebase Console > Project settings.
# FCM_SERVICE_ACCOUNT_PATH = path to the service account JSON key (not committed).
FCM_PROJECT_ID=luilaykhao-bb09f
FCM_SERVICE_ACCOUNT_PATH=storage/app/firebase-service-account.json

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_REDIRECT_URI=
LINE_BOT_PROMPT=normal
# Channel ID the LIFF app lives under (verifies liff.getAccessToken() tokens).
# Leave blank to reuse LINE_CLIENT_ID when the LIFF app shares the same channel.
LINE_LIFF_CHANNEL_ID=

FRONTEND_URL=http://localhost:5173  # On production: set to https://luilaykhao.com
# ^ Also where the password-reset link points. Wrong host here = reset tokens
#   mailed to customers that land on the wrong site.

# Analytics & ads. Both tags stay off entirely while these are blank, so local
# dev and CI never report anything. Fill them in per environment.
GA_MEASUREMENT_ID=          # GA4, e.g. G-XXXXXXXXXX
META_PIXEL_ID=              # Meta Pixel id from Events Manager
ANALYTICS_CONSENT_TTL_DAYS=365
ANALYTICS_EXCLUDE_ADMIN=true

# Mobile app version gate (consumed by /api/v1/app/version)
MIN_MOBILE_VERSION=0.1.0
LATEST_MOBILE_VERSION=0.1.0
MOBILE_STORE_URL=https://play.google.com/store/apps/details?id=com.luilaykhao.app
# Platform-specific store links (fall back to MOBILE_STORE_URL when unset)
MOBILE_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.luilaykhao.app
MOBILE_IOS_STORE_URL=https://apps.apple.com/th/app/luilaykhao/id6770391928?l=th
MOBILE_UPDATE_MESSAGE="อัปเดตเพื่อใช้ฟีเจอร์ใหม่และแก้ไขบั๊กล่าสุด"

# Universal / App Links — ตั้งค่าเพื่อให้ https://luilaykhao.com/gift/* เปิดแอปโดยตรง
# ปล่อยว่างไว้ = ปิดใช้งาน (ลิงก์จะเปิดหน้าเว็บเปิดของขวัญตามปกติ)
# IOS_APP_ID = <AppleTeamID>.com.luilaykhao.app
IOS_APP_ID=
ANDROID_PACKAGE=com.luilaykhao.app
# SHA256 fingerprints ของใบเซ็นแอป (คั่นด้วย , ได้หลายค่า เช่น debug + release + Play signing)
ANDROID_CERT_FINGERPRINTS=

# Live Activity ("รถถึงใน 8 นาที" บนหน้าจอล็อก / Dynamic Island)
# ต้องคุยกับ APNs ตรง เพราะ FCM ตั้ง topic <bundle>.push-type.liveactivity ไม่ได้
# ปล่อย APNS_KEY_ID/APNS_TEAM_ID ว่าง = ปิดฟีเจอร์ทั้งชุดโดยไม่พังอย่างอื่น
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.luilaykhao.app
# ไฟล์ .p8 จาก Apple Developer > Keys (สิทธิ์ APNs) — path สัมพัทธ์กับรากโปรเจ็กต์
APNS_KEY_PATH=storage/app/apns-auth-key.p8
# หรือวางเนื้อคีย์ทั้งก้อนตรงนี้แทน (สำหรับ deploy ด้วย secret manager)
APNS_KEY_CONTENT=
# false = ยิงเข้า sandbox (บิลด์ debug ที่ติดตั้งจาก Xcode), true = TestFlight/App Store
# คีย์บางใบผูกกับสภาพแวดล้อมเดียว — ถ้าตั้งผิดฝั่งจะได้ BadEnvironmentKeyInToken
# เช็คด้วย `php artisan apns:check` ได้โดยไม่ต้องมีเครื่องจริง
APNS_PRODUCTION=true

# Support contact info shown in mobile app help center (consumed by /api/v1/stats)
SUPPORT_PHONE=0900000000
SUPPORT_LINE_ID=@luilaykhao
SUPPORT_LINE_URL=https://line.me/R/ti/p/@luilaykhao
SUPPORT_EMAIL=support@luilaykhao.com

VITE_APP_NAME="${APP_NAME}"
VITE_GOOGLE_MAPS_API_KEY="${GOOGLE_MAPS_API_KEY}"
VITE_API_URL=http://localhost:8000
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
